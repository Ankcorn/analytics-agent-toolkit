{
  "name": "cf-agent-sql",
  "version": "0.1.0",
  "description": "Give AI SDK and Pi agents a schema-aware, read-only tool over the Cloudflare Analytics SQL binding",
  "keywords": [
    "agents",
    "ai-sdk",
    "analytics",
    "cloudflare",
    "pi",
    "sql",
    "tools",
    "workers"
  ],
  "license": "MIT",
  "author": "Thomas Ankcorn",
  "bin": {
    "asql": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p src/tests",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:package",
    "ci": "pnpm run build && pnpm run check && pnpm run test",
    "changeset": "changeset",
    "release": "pnpm run ci && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-durable": "^1.0.0",
    "@types/node": "^24.19.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "ai": "^7.0.127",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-durable": "^1.0.0",
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.9.0"
}
